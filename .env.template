# Copiar este archivo a `.env` y completar los valores marcados como
# "<...>" antes de levantar la plataforma con `docker compose up`.
# El `.env` real queda fuera de git (ver .gitignore) porque a partir de ahora
# contiene una credencial real: la API key de Kaggle.

MINIO_USER=admin
MINIO_PASS=password123
MINIO_PORT=9000
MINIO_PORT_UI=9001
DATALAKE_BUCKET_NAME=datalake
MODEL_ARTIFACTS_BUCKET_NAME=model-artifacts

# PostgreSQL (Metadata Store: Backend Store de MLflow + Metadata Store de Airflow)
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=mlflow
AIRFLOW_DB_NAME=airflow

# MLflow
# Puerto 5000 en host libre en Linux, pero en macOS lo usa AirPlay Receiver
# (ControlCenter) -> se publica en 5050 para evitar el choque.
MLFLOW_PORT=5050
MODEL_NAME=PredictionMovies

# Airflow
AIRFLOW_PORT=8080
AIRFLOW_FERNET_KEY=<generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())">
AIRFLOW_SECRET_KEY=<generar con: python -c "import secrets; print(secrets.token_hex(24))">
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=password123
AIRFLOW_ADMIN_EMAIL=admin@example.com

# Kaggle API: usada por la tarea `load_data` del DAG para descargar
# automáticamente TMDB_movie_dataset_v11.csv y subirlo al bucket Raw Data de
# MinIO la primera vez que corre (si el archivo ya está en MinIO, no se
# vuelve a descargar). Para obtener este token:
#   1. Crear una cuenta en https://www.kaggle.com si no tenés una.
#   2. Ir a https://www.kaggle.com/settings -> sección "API" -> "Create New Token".
#   3. Copiar el token generado (empieza con "KGAT_") acá abajo.
# Nota: esto es el token nuevo de Kaggle, no el kaggle.json de las
# "Legacy API Credentials" (ese formato usa KAGGLE_USERNAME/KAGGLE_KEY en
# vez de KAGGLE_API_TOKEN, y no es el que usa este proyecto).
KAGGLE_API_TOKEN=<tu_api_token_de_kaggle>

# FastAPI (Staging / Production)
FASTAPI_STAGING_PORT=8001
FASTAPI_PRODUCTION_PORT=8002

# Frontend (Staging / Production)
FRONTEND_STAGING_PORT=3001
FRONTEND_PRODUCTION_PORT=3002
